{
  "name": "Example: open a page and make basic assertions",
  "label": "example/open",
  "description": "Hermetic smoke test (uses a data: URL, needs no server). Good install self-check.",
  "steps": [
    {"action": "open", "url": "data:text/html,<title>WAT</title><h1 id='t'>Hello WAT</h1><button id='b'>Go</button>", "comment": "no network needed"},
    {"action": "assert_title", "value": "WAT"},
    {"action": "assert_element", "selector": "#t"},
    {"action": "assert_element_text", "selector": "#t", "value": "Hello WAT"},
    {"action": "assert_element", "selector": "#b"},
    {"action": "assert_no_console_errors"}
  ]
}
